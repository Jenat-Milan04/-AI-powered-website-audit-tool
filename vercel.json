{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/fetch-page", "destination": "/api/fetch-page" },
    { "source": "/api/analyze", "destination": "/api/analyze" }
  ]
}
